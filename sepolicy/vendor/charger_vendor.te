r_dir_file(charger_vendor, vendor_sysfs_battery_supply)
r_dir_file(charger_vendor, vendor_sysfs_usb_supply)
r_dir_file(charger_vendor, vendor_sysfs_usbpd_device)

allow charger_vendor vendor_sysfs_battery_supply:chr_file rw_file_perms;
allow charger_vendor vendor_sysfs_usb_supply:chr_file rw_file_perms;
allow charger_vendor vendor_sysfs_usbpd_device:chr_file rw_file_perms;

# Make charger permissive
userdebug_or_eng(`
  permissive charger;
  permissive charger_vendor;
')
